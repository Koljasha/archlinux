#!/usr/bin/env bash

#
# creating a working link system (for me: Koljasha disk's system)
#

# --- Настройки (измените под свою систему) ---

# Точка монтирования диска с личными данными.
STORAGE_MOUNT="${STORAGE_MOUNT:-/run/mount/storage}"
# UUID раздела диска (посмотреть командой: lsblk -f).
STORAGE_UUID="${STORAGE_UUID:-c6ab23b5-1b6d-4c3f-8488-6efee0144e54}"
# Метка раздела (для комментария в fstab).
STORAGE_LABEL="${STORAGE_LABEL:-Storage}"
# Каталог с личным архивом (zip) на диске.
ZIP_DIR="${ZIP_DIR:-Koljasha}"

# create fstab record
while [[ $rec != "1" ]] && [[ $rec != "2" ]]; do
    echo; echo
    echo "####################"
    echo "Create 'storage' folder and fstab record"
    echo "1) yes"
    echo "2) no"
    echo "####################"
    read -rn1 -p">" rec
done
echo; echo

if [[ $rec == "1" ]]; then
    # folder | fstab | mount

    sudo mkdir "$STORAGE_MOUNT"
    sudo chown "$USER:$USER" "$STORAGE_MOUNT"

    echo | sudo tee --append /etc/fstab
    echo "# /dev/sda4 LABEL=$STORAGE_LABEL" | sudo tee --append /etc/fstab
    echo "UUID=$STORAGE_UUID	$STORAGE_MOUNT/	ext4	rw,relatime	0 2" | sudo tee --append /etc/fstab
    echo | sudo tee --append /etc/fstab

    sudo systemctl daemon-reload
    sudo mount --all
fi
echo "Ok"


