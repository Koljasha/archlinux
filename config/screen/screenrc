# https://wiki.archlinux.org/title/GNU_Screen

#
# Краткая помощь
#
# ctrl-a - префикс по умолчанию
# ctrl-\ - используемый префикс
#
# `screen -ls` - список сессий
# `screen -r` - подключиться к последней сессии
#
# `prefix + ?` - помощь
# `prefix + d` - отсоединиться
#
# `prefix + c` - новое окно
# `prefix + "` - список окон
# `prefix + prefix` - предыдущее окно
# `prefix + space n p` - переключение окон
# `prefix + k` - удалить окно
#
# `prefix + | s` - разделение
# `prefix + tab` - переключение разделений
# `prefix + x` - удалить разделение
#


# замена префикса
escape ^\\

# терминал и цвета
truecolor on
term xterm-256color

# выключаем приветствие
startup_message off

# выключаем визуальный звонок
vbell off

# корректная работа редакторов, чтобы не висели на экране
altscreen on

# прокрутка в терминале
termcapinfo xterm*|rxvt*|kterm*|Eterm* ti@:te@

# размер буфера прокрутки
defscrollback 10000

# нормальный вывод в списке окон
windowlist string "%4n %h%=%f"

#
# Screen версия 5
#

# Настройка времени, обновление раз в 10 секунд
# с секундами (дергает статус, только локально): backtick 1 1 1 date "+%H:%M:%S"
backtick 1 10 10 date "+%H:%M"
hardstatus alwayslastline '%{#00ff00}[ %H ][ %{#ffffff}%= %{7}%?%-Lw%?%{1}%n%f %t%?%u%?%{7}%?%+Lw%? %=%{#00ff00} ][ %{#00a5ff}%{6}%Y-%m-%d %{#ffffff}%{7}%1`%{#00ff00} ]'

# Настройка средней загрузки (Load Average)
# backtick 2 5 5 sh -c "cat /proc/loadavg | cut -d' ' -f1-3"
