# Пользовательский конфиг ShellCheck.
#
# Когда применяется: ShellCheck сначала ищет .shellcheckrc / shellcheckrc
# в каталоге скрипта и во всех родительских каталогах, и только если не нашёл —
# берёт этот файл (~/.shellcheckrc), а затем $XDG_CONFIG_HOME/shellcheckrc
# (~/.config/shellcheckrc). Используется ПЕРВЫЙ найденный файл, настройки
# из разных файлов не смешиваются. Проекты с собственным .shellcheckrc
# этим файлом не затрагиваются.

# Разрешить ShellCheck открывать файлы, подключаемые через `source` или `.`,
# даже если они не переданы ему как входные. Без этого на `source lib.sh`
# выдаётся SC1091 «not following: file was not specified as input»
# (равнозначно флагу -x в командной строке).
external-sources=true

# Искать подключаемые файлы относительно самого проверяемого скрипта.
# Критично для одиночных скриптов вне проекта: `source ./lib.sh` рядом
# со скриптом резолвится корректно.
source-path=SCRIPTDIR
