# clip-mirror.service — зеркалирование CLIPBOARD -> PRIMARY

[Unit]
Description=Clipboard to Primary mirror (clip-mirror)

[Service]
ExecCondition=/usr/bin/bash -c 'pgrep -x "qtile|i3|openbox" > /dev/null'
ExecStart=%h/.config/scripts/clip-mirror.sh
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=default.target
