" ----------------------------------------
" Привязки клавиш
" ----------------------------------------

" меняем mapleader на " ", по умолчанию - "\"
let mapleader=" "
" устанавливаем задержку после нажатия
set timeoutlen=5000 ttimeoutlen=0

" help по слову при нажатии K
let &keywordprg=':help'

" Не закрывать последнее окно с Ctrl-w q
nnoremap <C-w>q :if winnr('$') > 1 \
            \| wincmd c \
            \| echo "Окно закрыто" \
            \| elseif tabpagenr('$') > 1 \
            \| tabclose \
            \| echo "Вкладка закрыта" \
            \| else \
            \| echo "Не закрываем последнее окно" \
            \| endif<CR>

" <Leader>/ - отключение подсветки поиска hlsearch
nnoremap <Leader>/ :nohlsearch <CR>

" <Leader>W|S - сохранение файла
nnoremap <Leader>W :w! <CR>
nnoremap <Leader>S :w! <CR>

" <Leader>X|Q - закрытие буфера без сохранения
nnoremap <Leader>Q :bp\|bd! #<CR>
nnoremap <Leader>X :bp\|bd! #<CR>

" <Leader>b - toggle буфер
nnoremap <Leader>b :b# <CR>
" <Leader>B - следующий буфер
nnoremap <Leader>B :bn <CR>
" откл: <Leader>B - предыдущий буфер
" nnoremap <Leader>B :bp <CR>

" копировать в системный буфер обмена: выделить, далее "+y
vnoremap <C-c> "+y
" вставить из системного буфера обмена: Ctrl-Shift-v
" вставить из буфера vim в режиме вставки: Ctrl-r + "
" список всех буферов|регистров: :registers

" vsplit|split
" nnoremap <Leader>v :vsplit
" nnoremap <Leader>vs :split
" vsplit|split по номеру буфера
" nnoremap <Leader>V :vertical sb
" nnoremap <Leader>VS :sb

" Vsplit and Tab
nnoremap <Leader>v <C-w>v
nnoremap <Leader>V <C-w>T

" сменить split
nnoremap <C-Left> <C-W>h
nnoremap <C-Down> <C-W>j
nnoremap <C-Up> <C-W>k
nnoremap <C-Right> <C-W>l

" изменить размера split
nnoremap <C-S-Left> <C-W><
nnoremap <C-S-Down> <C-W>-
nnoremap <C-S-Up> <C-W>+
nnoremap <C-S-Right> <C-W>>

" перемещение стрелками в командном режиме
cnoremap <Down> <C-n>
cnoremap <Up> <C-p>

" F4 - режим вставки (Paste; из insert выход в normal)
nnoremap <F4> :set paste! <CR>
inoremap <F4> <Esc> :set paste! <CR>

" F5 - сохранение файла (из insert выход в normal)
nnoremap <F5> :w! <CR>
inoremap <F5> <Esc> :w! <CR>
" Shift-F5 - сохранить с sudo
nnoremap <S-F5> :execute ':silent w !sudo tee % > /dev/null' <bar> :edit! <CR>

" F6 - сохранить свертки
" nnoremap <F6> :mkview <CR>
" Shift-F6 - загрузить свертки
" nnoremap <S-F6> :loadview <CR>

" F7 - показать пробелы и табы
nnoremap <F7> :set list! <CR>
" Shift-F7 - использовать табы вместо пробелов
nnoremap <S-F7> :set noet! <CR>

" F8 - отключение нумерации
nnoremap <F8> :set number! relativenumber! <CR>
" Shift-F8 - относительная нумерация
nnoremap <S-F8> :set relativenumber! <CR>

" F9 - отключение мыши
nnoremap <F9> :set mouse= <CR>
" Shift-F9 - включение мыши
nnoremap <S-F9> :set mouse=a <CR>

" F11 (откл) - проверка орфографии
" nnoremap <F11> :setlocal spelllang=ru spell! <CR>
" ]s - следующее слово с ошибкой
" [s - предыдущее слово с ошибкой
" z= - замена из списка
" zg - добавить в словарь
" zw - убрать из словаря
" zG - игнорировать слово

" F11 - подсветка csv
nnoremap <F11> :set filetype=text <CR>
nnoremap <S-F11> :set filetype=csv <CR>

" F12 - режим сравнения (vimdiff)
nnoremap <F12> :set diff! <CR>

" ----------------------------------------
" Help Some Keys
" ----------------------------------------

" ----------------------------------------
" eVim - перейти в normal mode: ctrl-l
" ----------------------------------------
" ctrl-g - показать какой файл редактируем
" ----------------------------------------
" автодополнения по i_ctrl-x_ далее:
" ctrl-l - добавить строку
" ctrl-n ctrl-p ctrl-i - добавить слово
" ctrl-f - добавить имя файла
" ctrl-o - добавить из языка (автодополнение)
" ----------------------------------------
" i_ctrl-o - переход в нормальный режим на одну команду
" ----------------------------------------
" ~, U, u - изменение регистра
" :%s/\<./\u&/g - Первая Буква Строчная
" ----------------------------------------
" сортировка - выделить - :sort
" обратная сортировка - выделить - :sort!
" сортировка уникальные - выделить - :sort u
" ----------------------------------------
" = (на выделенном) - сделать корректный отступ
" ----------------------------------------
" gf - открыть путь под курсором
" gx - открыть ссылку в браузере
" gv - повторное выделение
" ----------------------------------------
" gt - следующая вкладка
" ctrl-w + T - перенести split на другую вкладку
" ----------------------------------------
" ctrl-w + q - закрыть окно(сплит) (буфер открыт)
" ctrl-w + o - закрыть другие сплиты
" ctrl-w + s - открыть split
" ctrl-w + v - открыть vsplit
" ctrl-w + r - поменять окна(сплиты) местами
" ctrl-w + H(L) - поменять split на vertical
" ctrl-w + K(J) - поменять vertical на split
" :[vertical] sb<num_buffer> - vsplit|split по номеру буфера
" ----------------------------------------
" ctrl-e и ctrl-y - экран вниз/вверх с сохранением курсора
" ctrl-d и ctrl-u - экран на половину вниз/вверх
" ----------------------------------------
" m<letter> - создать закладку
" '<letter> - перейти к началу строки закладки
" `<letter> - перейти к закладке
" ----------------------------------------
" '. или `. - последние изменение
" '' или `` - перемещение на предыдущее место
" ma - создать метку
" `a - перейти на метку a
"  '] `] - перемещение в конец после копирования
" :jumps - история перемещений
" ctrl-o и ctrl-i - перемещение по истории перемещений
" :changes - история изменений
" g; и g, - перемещение по истории изменений
" ----------------------------------------
" ctrl-] и ctrl-t - перемещение по топикам Помощи
" ----------------------------------------
" q<letter> - создание макроса, закончить q
" @<letter> - вызов макроса
" ----------------------------------------
"  vimdiff:
"  dp - перенести в другую часть
"  do - получить из другой части
" ----------------------------------------
" сворачивание на основании отступов в начале строк
" set foldmethod=indent
" сворачивание на основании синтакса
" set foldmethod=syntax
"
" v/V и zf - выделение блока и создание свертки
" zd - удалить свертку
"
" zc – свернуть блок
" zo – развернуть блок
" zm - свернуть все свертки
" zr - развернуть все свертки
" za – инвертирование
" zi - инвертировть все свертки
"
" zk - переход на свертку выше по тексту
" zj - переход на свертку ниже по тексту
"
" :mkview - сохранить структуру сверток
" :loadview - загрузить структуру сверток
" ----------------------------------------
" :mksession[!] [filename] - сохранить сессию
" :source [filename] - загрузить сессию
" ----------------------------------------

" ----------------------------------------
" ----------------------------------------

" vim:ft=vim

