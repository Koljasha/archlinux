#!/usr/bin/env bash

# Хук git pre-commit.
#
# Синхронизирует номера строк русской локализации из `packages`
# с номерами, указанными в `README.md`.
#
# Раньше хук читал фиксированную строку README, поэтому ломался при любом
# сдвиге текста. Теперь строка README ищется по шаблону
# «`./packages` ... : N - M», а номер берётся из самого `packages`.
#
# Для автоматической работы скопируйте этот файл в `.git/hooks/`;
# для ручного запуска — выполните его в каталоге `hooks/`.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
readme_file="$repo_root/README.md"
packages_file="$repo_root/packages"

# Первая строка диапазона — строка с командой переключения раскладки.
locale_line="$(grep -n 'enable change locale' "$packages_file" | cut -d: -f1)"

if [[ -z "$locale_line" ]]; then
    echo "pre-commit: в $packages_file не найдена строка 'enable change locale'" >&2
    exit 1
fi

# В README указан диапазон из двух строк: сама команда и следующая за ней.
sed -i -E \
    "s|(\`\./packages\`[^:]*: )[0-9]+ - [0-9]+|\1${locale_line} - $((locale_line + 1))|" \
    "$readme_file"

git add "$readme_file"
