[init]
    defaultBranch = master

[core]
    editor = vim
    pager = delta
    preloadIndex = true
    fscache = true

[diff]
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[merge]
    tool = vimdiff
    conflictstyle = diff3

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true

[protocol]
    version = 2
[fetch]
    parallel = 8
[submodule]
    fetchJobs = 8
[pack]
    threads = 0

